# Publish only the manuscript and its rendering dependencies.
# Everything else (including local notes, data, scripts, and caches) stays local.
/*
!/.gitattributes
!/.gitignore
!/Makefile
!/README.md
!/latexmkrc
!/main.tex
!/references.bib

# This small standard-library helper is a rendering/build dependency.
!/tools/
/tools/*
!/tools/publish_pdf.py

!/sections/
/sections/*
!/sections/*.tex

!/figures/
/figures/*
!/figures/overview.pdf
!/figures/evidence_gaps.pdf
!/figures/framework.pdf
!/figures/evolution.pdf
!/figures/analysis_coverage.pdf
!/figures/research_diagnostics.pdf
!/figures/subsets.pdf
!/figures/*_float.tex

!/tables/
/tables/*
!/tables/analysis_scores.tex
!/tables/analysis_families.tex
!/tables/analysis_cost.tex
!/tables/benchmark_results.tex

!/vendor/
/vendor/*
!/vendor/iclr2027/
/vendor/iclr2027/*
!/vendor/iclr2027/iclr2027_conference.sty
!/vendor/iclr2027/iclr2027_conference.bst
!/vendor/iclr2027/fancyhdr.sty
!/vendor/iclr2027/natbib.sty

!/build/
/build/*
!/build/main.pdf
